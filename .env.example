# TypeSafe Jev (System One) key — https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Pin a version (e.g. jev-1.14.0) once you've tuned the threshold
JEV_MODEL=jev-latest

# OpenAI key for live speech-to-text (Realtime API, gpt-4o-mini-transcribe)
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=en

# Optional shared passcode teammates enter in Settings before the app will spend the keys
ACCESS_CODE=

# Set to 1 to fake Jev with simple word overlap (for UI work without a key)
MOCK_JEV=0
